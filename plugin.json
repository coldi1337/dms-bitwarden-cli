{
  "id": "bitwarden",
  "name": "Bitwarden Dankbar",
  "description": "Search and manage Bitwarden or Vaultwarden directly in DMS using the official Bitwarden CLI.",
  "version": "1.8.1-dms.2",
  "author": "David Spencer; DMS port by coldi1337",
  "license": "MIT",
  "icon": "shield",
  "type": "composite",
  "components": {
    "widget": "./BarWidget.qml",
    "daemon": "./Panel.qml"
  },
  "settings": "./Settings.qml",
  "capabilities": [
    "dankbar-widget",
    "ipc"
  ],
  "requires_dms": ">=1.6.0",
  "dependencies": [
    "bitwarden-cli",
    "jq",
    "wl-clipboard"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "process",
    "network"
  ]
}
